{
  "name": "grid-los-backend",
  "version": "1.0.0",
  "description": "二维方格地图视线遮挡与可见区域解释后端（TypeScript + Node.js + SQLite）",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
